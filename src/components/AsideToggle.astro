---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button
  type="button"
  class="aside-toggle"
  aria-expanded="true"
  aria-controls="side-panel"
  aria-label={t(lang, 'aside.index')}
  title={t(lang, 'aside.index')}
>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M9.9 3.75 5.65 8l4.25 4.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script is:inline>
  // Mostrar u ocultar el panel lateral.
  //
  // La decisión NO se guarda: cada página se abre con el índice a la
  // vista. Es lo primero que hay que ver al entrar en una sección, y
  // recordar que alguien lo cerró una vez deja el sitio sin su mapa.
  (function () {
    var root = document.querySelector('.with-aside');
    var button = document.querySelector('.aside-toggle');
    if (!root || !button) return;

    button.addEventListener('click', function () {
      var hidden = !root.classList.contains('aside-hidden');
      root.classList.toggle('aside-hidden', hidden);
      button.setAttribute('aria-expanded', hidden ? 'false' : 'true');
    });
  })();
</script>
