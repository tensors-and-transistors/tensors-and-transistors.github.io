---
import { t, type Lang, type Section } from '../i18n/ui';

interface Props {
  lang: Lang;
  section: Section;
}

const { lang, section } = Astro.props;

// El rótulo es el de la sección: "Sigue aprendiendo" en el blog,
// "Lee también" en las explicaciones.
const rotulo = t(lang, `aside.${section}` as 'aside.blog');
---

<button
  type="button"
  class="aside-toggle"
  aria-expanded="false"
  aria-controls="side-panel"
  aria-label={rotulo}
  title={rotulo}
>
  <span class="aside-toggle-label">{rotulo}</span>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M9.9 3.75 5.65 8l4.25 4.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script is:inline>
  // Abrir y cerrar el cajón del índice.
  //
  // El estado NO se guarda: cada artículo abre cerrado. Quien llega a un
  // artículo viene a leerlo, no a elegir otro; el índice espera detrás
  // del tirador hasta que hace falta.
  (function () {
    var root = document.querySelector('.with-aside');
    var button = document.querySelector('.aside-toggle');
    if (!root || !button) return;

    function abrir(si) {
      root.classList.toggle('aside-open', si);
      button.setAttribute('aria-expanded', si ? 'true' : 'false');
    }

    button.addEventListener('click', function () {
      abrir(!root.classList.contains('aside-open'));
    });

    // Escape lo cierra, como cualquier cajón del sistema.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') abrir(false);
    });
  })();
</script>
