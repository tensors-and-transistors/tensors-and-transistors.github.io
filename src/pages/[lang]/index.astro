---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, SITE_NAME, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

---

<BaseLayout lang={lang} title={SITE_NAME} description={t(lang, 'site.intro')} home>
  <section class="hero-x">
    <!-- Dos capas de fondo: el degradado y el mosaico. Las dos decorativas,
         así que se ocultan a los lectores de pantalla. -->
    <div class="hero-bg" aria-hidden="true"></div>
    <!-- El mosaico es una imagen, no 4.000 etiquetas dentro de la página:
         el navegador la dibuja una vez y la guarda en su caché.
         Se genera con `node scripts/mosaic.mjs`. -->
    <div class="hero-mosaic" aria-hidden="true"></div>

    <div class="hero-inner">
      <img
        class="hero-logo"
        src="/tnt_logo.svg"
        alt={SITE_NAME}
        width="1882"
        height="666"
        fetchpriority="high"
      />
      <h1 set:html={t(lang, 'hero.title')} />

      <div class="hero-cta">
        <a href={`/${lang}/blog/`}>
<span class="hero-card-art art-blog" aria-hidden="true"></span>
          <span class="hero-cta-label">{t(lang, 'nav.blog')}</span>
          <span class="hero-cta-desc" set:html={t(lang, 'hero.blogDesc')} />
        </a>
        <a href={`/${lang}/papers/`}>
<span class="hero-card-art art-papers" aria-hidden="true"></span>
          <span class="hero-cta-label">{t(lang, 'nav.papers')}</span>
          <span class="hero-cta-desc" set:html={t(lang, 'hero.papersDesc')} />
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
