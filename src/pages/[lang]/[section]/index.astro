---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, SECTIONS, t, formatDate, type Lang, type Section } from '../../../i18n/ui';

// Genera una página por cada combinación idioma × sección:
// /es/blog/, /es/tutorials/, /es/papers/, /en/blog/, ...
export function getStaticPaths() {
  return LANGS.flatMap((lang) => SECTIONS.map((section) => ({ params: { lang, section } })));
}

const lang = Astro.params.lang as Lang;
const section = Astro.params.section as Section;

// Los .md viven en src/content/<sección>/<idioma>/, así que filtramos
// por el prefijo del identificador y descartamos los borradores.
const posts = (await getCollection(section))
  .filter((entry) => entry.id.startsWith(`${lang}/`) && !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Aquí NO hay panel: esta página ya es el índice de la sección. El cajón
// del índice solo aparece dentro de un artículo, donde sirve para saltar
// al siguiente.

const title = t(lang, `section.${section}.title` as 'section.blog.title');
const description = t(lang, `section.${section}.desc` as 'section.blog.desc');
---

<BaseLayout lang={lang} title={title} description={description}>
  <!-- La banda de cabecera: el mismo dibujo que la tarjeta de esta
       sección en la portada, redibujado para una franja ancha. El título
       vive dentro, no debajo: la banda ES la cabecera de la sección. -->
  <header class:list={['section-hero', `hero-${section}`]}>
    <div class="section-hero-inner">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </header>

  <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="empty">{t(lang, 'list.empty')}</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => {
              const slug = post.id.split('/').slice(1).join('/');
              return (
                <li class="post-item">
                  <a href={`/${lang}/${section}/${slug}/`}>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                    <div class="post-meta">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate, lang)}
                      </time>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
  </div>
</BaseLayout>
